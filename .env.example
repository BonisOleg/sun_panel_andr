SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.develop
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=True

# --- Nova Poshta (sync міст/відділень) ---
NP_API_KEY=

# --- Delivery Auto (https://www.delivery-auto.com/uk-UA/Home/API) ---
DELIVERY_PUBLIC_KEY=
DELIVERY_SECRET_KEY=
DELIVERY_BASE_URL=https://www.delivery-auto.com/api/v4/Public/
# GUID основного вантажного складу відправника (заповнити після реєстрації кабінету)
DELIVERY_SENDER_WAREHOUSE_ID=
DELIVERY_SENDER_CITY_ID=
# GUID доп.послуги «дерев'яна обрешітка / палетування» з dopUslugaClassificator
DELIVERY_CRATE_SERVICE_ID=

# --- Email (Resend SMTP) ---
# Docs: https://resend.com/docs/send-with-smtp
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxxxxxxx  # Resend API key
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=noreply@your-verified-domain.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@soliron.local
# Куди слати замовлення/ліди (fallback, якщо в адмінці Site settings порожньо)
NOTIFY_EMAIL=

# --- Telegram admin alerts (один менеджер) ---
# 1) BotFather → токен  2) Start боту  3) getUpdates → chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_TIMEOUT=5

POSTGRES_DB=soliron
POSTGRES_USER=soliron
POSTGRES_PASSWORD=change-me
DATABASE_URL=
CSRF_TRUSTED_ORIGINS=
HTTP_PORT=80

# Production Droplet: copy .env.docker.example → .env on the server (not this file).
