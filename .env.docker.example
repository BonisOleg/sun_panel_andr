# Droplet / Docker production (HTTP by IP). Copy to .env on the server.
#   cp .env.docker.example .env && nano .env
# Do not commit .env.

SECRET_KEY=
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production

# Replace DROPLET_IP after the droplet is created. Keep web,127.0.0.1,localhost.
ALLOWED_HOSTS=DROPLET_IP,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=http://DROPLET_IP

# HTTP test: False. After Let's Encrypt set both to True.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

POSTGRES_DB=soliron
POSTGRES_USER=soliron
POSTGRES_PASSWORD=
# Same credentials as POSTGRES_* above. Avoid @ : / inside the password value.
# Example shape (fill real values only in server .env, never commit them):
# DATABASE_URL=postgres://soliron:YOUR_DB_PASS@db:5432/soliron
DATABASE_URL=

HTTP_PORT=80

# --- Nova Poshta ---
NP_API_KEY=

# --- Delivery Auto ---
DELIVERY_PUBLIC_KEY=
DELIVERY_SECRET_KEY=
DELIVERY_BASE_URL=https://www.delivery-auto.com/api/v4/Public/
DELIVERY_SENDER_WAREHOUSE_ID=
DELIVERY_SENDER_CITY_ID=
DELIVERY_CRATE_SERVICE_ID=

# --- Email via Resend SMTP ---
# https://resend.com/docs/send-with-smtp
# Empty EMAIL_HOST → emails go to container logs (console backend).
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Must be a Resend-verified domain sender (or onboarding@resend.dev for tests).
DEFAULT_FROM_EMAIL=noreply@your-verified-domain.com
# Fallback if Unfold → Site settings → notify_email is empty.
NOTIFY_EMAIL=

# --- Telegram (один менеджер / один chat_id) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_TIMEOUT=5
