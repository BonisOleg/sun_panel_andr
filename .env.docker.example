# Production Docker — soliron.com.ua / 68.183.212.53
# На сервері: cp .env.docker.example .env && nano .env
# Не комітити .env.

SECRET_KEY=
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
# Staff Unfold URL (ERR-132). Never "admin". Trailing slash optional.
ADMIN_URL=sol-cabin

# HTTP-фаза (до DNS/SSL). Після DNS залиште обидва хости.
ALLOWED_HOSTS=68.183.212.53,soliron.com.ua,www.soliron.com.ua,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=http://68.183.212.53,http://soliron.com.ua,http://www.soliron.com.ua

# Канонічний публічний origin (sitemap/robots/OG/canonical).
# HTTP зараз → після SSL змініть на https://soliron.com.ua
PUBLIC_BASE_URL=http://68.183.212.53

# HTTP test: False. Після Let's Encrypt → True для cookie/redirect.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

POSTGRES_DB=soliron
POSTGRES_USER=soliron
POSTGRES_PASSWORD=
# DATABASE_URL must use the same DB user/password as POSTGRES_* (set only on server .env).
# Avoid special characters @ : / inside the password value.
DATABASE_URL=

HTTP_PORT=80

# --- Nova Poshta ---
NP_API_KEY=

# --- Delivery Auto ---
DELIVERY_PUBLIC_KEY=
DELIVERY_SECRET_KEY=
DELIVERY_BASE_URL=https://www.delivery-auto.com/api/v4/Public/
DELIVERY_SENDER_WAREHOUSE_ID=
DELIVERY_SENDER_CITY_ID=
DELIVERY_CRATE_SERVICE_ID=

# --- Email via Resend SMTP ---
# https://resend.com/docs/send-with-smtp
# Empty EMAIL_HOST → emails go to container logs (console backend).
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=8
# Must be a Resend-verified domain sender (або onboarding@resend.dev для тестів).
DEFAULT_FROM_EMAIL=noreply@soliron.com.ua
# Fallback if Unfold → Site settings → notify_email is empty.
NOTIFY_EMAIL=

# --- Telegram (один менеджер / один chat_id) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_TIMEOUT=5
