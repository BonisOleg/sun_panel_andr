# Droplet / Docker production (HTTP by IP). Copy to .env on the server.
#   cp .env.docker.example .env && nano .env
# Do not commit .env.

SECRET_KEY=generate-a-long-random-string
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production

# Replace DROPLET_IP after the droplet is created. Keep web,127.0.0.1,localhost.
ALLOWED_HOSTS=DROPLET_IP,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=http://DROPLET_IP

# HTTP test: False. After Let's Encrypt set both to True.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

POSTGRES_DB=soliron
POSTGRES_USER=soliron
POSTGRES_PASSWORD=change-me-strong
# Use the same password as POSTGRES_PASSWORD. Avoid @ : / in the password (URL).
DATABASE_URL=postgres://soliron:change-me-strong@db:5432/soliron

HTTP_PORT=80

NP_API_KEY=
DELIVERY_PUBLIC_KEY=
DELIVERY_SECRET_KEY=
DELIVERY_BASE_URL=https://www.delivery-auto.com/api/v4/Public/
DELIVERY_SENDER_WAREHOUSE_ID=
DELIVERY_SENDER_CITY_ID=
DELIVERY_CRATE_SERVICE_ID=

# Empty EMAIL_HOST → emails go to container logs (console backend).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@soliron.local
# Admin notify address lives in Unfold → Site settings (notify_email), not here.
